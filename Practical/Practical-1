import csv
#Take item data from the user
def get_fruit_data():
    fruits = []
    n = int(input("Enter number of fruit items: "))
    for i in range(n):
        print(f"\nFruit item {i+1}:")
        name = input("Fruit name: ")
        unit_price = float(input("Unit price (TK): "))
        quantity = int(input("Quantity (KG): "))
        total_price = unit_price * quantity
        fruits.append([name, unit_price, quantity, total_price])
    return fruits

#Mount Drive
from google.colab import drive
drive.mount('/content/drive')

#Store items data into CSV file
def save_to_csv(fruits, filename="/content/drive/MyDrive/fruits_inventory.csv"):
    header = ["Fruit Name", "Unit Price(TK)", "Quantity(KG)", "Total Price(TK)"]
    with open(filename, mode="w", newline="") as file:
        writer = csv.writer(file)
        writer.writerow(header)
        writer.writerows(fruits)
        print(f"\nData saved into {filename}")

#Print fruits items summary data from stored CSV file
def print_from_csv(filename="/content/drive/MyDrive/fruits_inventory.csv"):
    print("\n--- Fruits Inventory Summary ---")
    with open(filename, mode="r") as file:
        reader = csv.reader(file)
        for row in reader:
            print(", ".join(row))

#Run the flow
if __name__ == "__main__":
    fruits_data = get_fruit_data()
    save_to_csv(fruits_data)
    print_from_csv()
