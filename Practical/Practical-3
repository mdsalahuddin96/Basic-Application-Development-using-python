import qrcode
from barcode.codex import Code128     
from barcode.writer import ImageWriter
from PIL import Image
from pyzbar.pyzbar import decode
from datetime import datetime

# Function to take student ID and name
def take_student_info():
    student_id = input("Enter Student ID: ")
    name = input("Enter Name: ")
    return student_id, name

# Function to generate QR code
def generate_qr_code(student_id, name):
    data = f"Student ID: {student_id}, Name: {name}"
    qr = qrcode.QRCode(version=1, box_size=10, border=5)
    qr.add_data(data)
    qr.make(fit=True)
    qr_img = qr.make_image(fill='black', back_color='white')
    qr_img.save("QR_Code_1.png")
    print("QR code generated successfully.")

# Function to generate Barcode
def generate_barcode(student_id, name):
    data = f"Student ID: {student_id}, Name: {name}"
    barcode = Code128(data, writer=ImageWriter())
    barcode.save("Barcode_1")  # Saves as PNG
    print("Barcode generated successfully.")

# Function to decode QR and Barcode
def decode_images():
    qr_data = []
    barcode_data = []

    # Read QR Code
    qr_img_paths = ["QR_Code_1.png"]
    for img_path in qr_img_paths:
        img = Image.open(img_path)
        decoded = decode(img)
        qr_data.extend(decoded)

    # Read Barcode
    barcode_img_paths = ["Barcode_1.png"]
    for img_path in barcode_img_paths:
        img = Image.open(img_path)
        decoded = decode(img)
        barcode_data.extend(decoded)

    return qr_data, barcode_data

# Function to print decoded data
def print_decoded_data(qr_data, barcode_data):
    print("\nDecoded QR Code Data:")
    if qr_data:
        for qr in qr_data:
            print(qr.data.decode('utf-8'))
    else:
        print("No QR code detected.")

    print("\nDecoded Barcode Data:")
    if barcode_data:
        for bc in barcode_data:
            print(bc.data.decode('utf-8'))
    else:
        print("No Barcode detected (pyzbar sometimes fails to decode Code128 PNG).")

# Main function
def main():
    student_id, name = take_student_info()
    generate_qr_code(student_id, name)
    generate_barcode(student_id, name)

    qr_data, barcode_data = decode_images()
    print_decoded_data(qr_data, barcode_data)

if __name__ == "__main__":
    main()
