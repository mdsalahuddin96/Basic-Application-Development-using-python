import csv
from reportlab.lib import colors
from reportlab.lib.pagesizes import A4
from reportlab.platypus import SimpleDocTemplate, Table, TableStyle

#2.2 Store Student basic information into csv file
def save_students_to_csv(filename="students.csv"):
  header=["Student_Id","Name","Roll","Semester","Shift","Department","Date of Birth","Phone No."]
  students=[
      ["101","Ishan","1201","5th","Morning","CSE","2002-01-15","01711111111"],
      ["102","Rehian","1202","5th","Morning","EEE","2001-71-10","01722222222"],
      ["103","Reshin","1203","5th","Evening","Civil","2000-03-25","01733333333"],
      ["104","Prethi","1204","5th","Morning","Mechanical","2002-11-05","01744444444"],
  ]
  with open(filename, mode='w', newline='') as file:
    writer=csv.writer(file)
    writer.writerow(header)
    writer.writerows(students)
  print(f"CSV file '{filename}' created successfully.")

#2.3 Generate PDF report from csv file
def generate_pdf_from_csv(csv_file='students.csv', pdf_file="students_report.pdf"):
  with open(csv_file, mode='r') as file:
    reader=csv.reader(file)
    data=list(reader)
  pdf=SimpleDocTemplate(pdf_file, pagesize=A4)
  table=Table(data)
  style=TableStyle([
      ('BACKGROUND',(0,0),(-1,0),colors.lightblue),
      ('TEXTCOLOR',(0,0),(-1,0),colors.whitesmoke),
      ('ALIGN',(0,0),(-1,-1),'CENTER'),
      ('FONTNAME',(0,0),(-1,0),'Helvetica-Bold'),
      ('FONTSIZE',(0,0),(-1,0),12),
      ('BOTTOMPADDING',(0,0),(-1,0),10),
      (('BACKGROUND',(0,1),(-1,-1),colors.beige)),
      (('GRID',(0,0),(-1,-1),1,colors.black)),
  ])
  table.setStyle(style)
  elements=[table]
  pdf.build(elements)
  print(f"PDF report '{pdf_file}' generated successfully.")
if __name__ == "__main__":
  save_students_to_csv()
  generate_pdf_from_csv()
